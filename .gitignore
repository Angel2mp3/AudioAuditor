# Build outputs
bin/
obj/
publish/
cloudflare-pages/
out/
build/
temp/
Temp/
final-releases/
release/
Release/
releases/
Debug/
x64/
x86/
artifacts/
archive/
BenchmarkDotNet.Artifacts/
*.exe
*.pdb
*.binlog
*_wpftmp.csproj
Experimental-Builds/
experimental-builds/
icon-test/


/*.png
/*.svg
/*.jpg
/*.jpeg
/*.gif
/*.bmp
/*.webp
# Logo.png is the README / website logo and is deliberately tracked at the repo root.
# Logo.ico is gone — nothing referenced it; the app and installer use Resources/app.ico.
!/Logo.png

# NuGet
packages/
*.nupkg
*.snupkg
project.lock.json
*.nuget.props
*.nuget.targets
*.nuget.g.*
*.dgspec.json
project.assets.json

# User-specific files
*.user
*.suo
proxy/
Proxy/
*.userprefs
*.vspscc
*.vssscc
*.sln.docstates
*.code-workspace
# The public .sln carries only WPF + CLI + Core. *.Local.sln keeps the test
# projects and the Avalonia port in one solution for local work.
*.Local.sln


# IDE / VS files
.vs/
*.rsuser
launchSettings.json
Properties/launchSettings.json
AudioAuditor.Windows.Tests/
AudioAuditor.Core.Tests/

# JetBrains Rider
.idea/
*.sln.iml

# Visual Studio Code
.vscode/

# OS files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
._*
$RECYCLE.BIN/

# Sensitive / session data — NEVER commit these
session.dat
*.dat
*.key
*.pem
*.pfx
*.p12
*.credentials
*.secret

# Dev / temp / personal files
scripts/
# The technical-reference set under docs/ is unfinished and is held back from release.
# Un-ignore it once the papers are accurate; the README deliberately links to none of them.
docs/
dev-notes/
# Scratch media + internal review notes. Holds commercial audio files used as
# detector fixtures — never publishable.
dev-tests/
to-do.txt
todo.md
ai-detection-improvements.txt
.recovery/
website-broken-backup/
# Timestamped backups written by the website safety procedure in AGENTS.md
website-backups/
# Same snapshots under their older name; these hold copies of website/, which is
# itself ignored, so tracking them would leak that tree into the public repo.
backups/

# Local-only umbrella: reference trees, worker configs, and agent-tool caches
# moved off the repo root to keep it readable.
_local/

# Windows shortcuts (embed local paths)
*.lnk

# Tooling
.vercel/
**/.vercel/

# Cloudflare worker
# The bare pattern covers the whole tree, caches and wrangler config included.
contact-worker

# ═══ Vendored reference source (not built by this repo) ═══
# cambia's Rust tree and pano-scrobbler are kept locally for reference only. The shipped
# binaries live in third-party/, which stays tracked so the folder layout and README ship.
# Both patterns are anchored to the repo root: a bare `cambia/` also matched
# third-party/cambia/, which contradicted the line above.
/cambia/
/cambia-master/
/pano-scrobbler-main/

# ═══ Cross-platform port ═══
AudioAuditor.Avalonia/
AVALONIA_PORT_PLAN.md

# ═══ Website ═══
website/

# ═══ Web app (unreleased; lives outside the website publish root) ═══
web-app-dev/

# Generated/local web files
website/cloudflare-pages/
publish/cloudflare-pages/

# SH Labs secrets (any location)
**/SHLabsSecrets.cs

# Internal security documentation
SECURITY_INTERNALS.md

# Environment files — global, not just under website/ and web-app-dev/
.env
.env.*
*.local
*.dev.vars

# Node / Wrangler
node_modules/
.wrangler/
web-app-dev/app/node_modules/
web-app-dev/app/proxy/.env
web-app-dev/app/proxy/.env.*
web-app-dev/app/proxy/*.local
web-app-dev/app/proxy/*.log
website/.wrangler/
website/.env
website/.env.*
website/.dev.vars
website/*.local
todo.txt
TODO.txt
notes.txt
# Session hand-off scratch notes
resume from this.txt
resume*.txt
*.tmp
*.bak
*.swp
*.log
*.lcov
*.tsbuildinfo
*.orig
*.cache
~$*
*.~*

