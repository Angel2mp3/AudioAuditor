<Window x:Class="AudioQualityChecker.ErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        Width="420" MinHeight="200" MaxHeight="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <!-- Colours come from the code-behind (ApplySeverity) via TemplateBinding, so one
             template covers error / warning / info / question without four XAML variants. -->
        <Style x:Key="AlertButton" TargetType="Button">
            <Setter Property="Width" Value="90"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Surface, glyph, title, body and button brushes are all applied by ApplySeverity. -->
    <Border x:Name="Surface" BorderThickness="1.5" CornerRadius="8">
        <Grid Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="GlyphText" Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TitleText" Text="Error" FontSize="16" FontWeight="Bold"
                               FontFamily="{DynamicResource AppFontFamily}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Message -->
            <ScrollViewer Grid.Row="1" Margin="0,12,0,12" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap"
                           FontSize="13" FontFamily="{DynamicResource AppFontFamily}"
                           LineHeight="20"/>
            </ScrollViewer>

            <!-- CancelButton stays collapsed unless this is a confirm dialog. -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="No" Margin="0,0,8,0"
                        Visibility="Collapsed" IsCancel="True"
                        Style="{StaticResource AlertButton}" Click="Cancel_Click"/>
                <Button x:Name="OkButton" Content="OK" IsDefault="True"
                        Style="{StaticResource AlertButton}" Click="OK_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
