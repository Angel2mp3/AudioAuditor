<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>AudioQualityChecker</RootNamespace>
    <AssemblyName>AudioAuditor</AssemblyName>
    <Version>2.0.0</Version>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- Exclude sub-projects from being compiled by this project -->
  <ItemGroup>
    <Compile Remove="AudioAuditorCLI\**" />
    <None Remove="AudioAuditorCLI\**" />
    <Compile Remove="AudioAuditor.Core\**" />
    <None Remove="AudioAuditor.Core\**" />
    <Compile Remove="AudioAuditor.Avalonia\**" />
    <None Remove="AudioAuditor.Avalonia\**" />
    <Page Remove="AudioAuditor.Avalonia\**" />
    <Compile Remove="AudioAuditorMac\**" />
    <None Remove="AudioAuditorMac\**" />
    <!-- Gitignored scratch. archive/ holds deliberately-removed code that no longer compiles,
         and the default **/*.cs glob was picking it up and failing the build. -->
    <Compile Remove="dev-tests\**" />
    <None Remove="dev-tests\**" />
    <Compile Remove="AudioAuditor.Tests\**" />
    <None Remove="AudioAuditor.Tests\**" />
    <Compile Remove="AudioAuditor.Core.Tests\**" />
    <None Remove="AudioAuditor.Core.Tests\**" />
    <Compile Remove="AudioAuditor.Windows.Tests\**" />
    <None Remove="AudioAuditor.Windows.Tests\**" />
    <Compile Remove="icon-test\**" />
    <None Remove="icon-test\**" />
    <Compile Remove="temp\**" />
    <None Remove="temp\**" />
    <EmbeddedResource Remove="temp\**" />
    <Page Remove="temp\**" />
    <Compile Remove="archive\**" />
    <None Remove="archive\**" />
    <Compile Remove="Experimental-Builds\**" />
    <None Remove="Experimental-Builds\**" />
    <Page Remove="Experimental-Builds\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- DiscordRichPresence is not listed here: DiscordRichPresenceService lives in
         AudioAuditor.Core, which references the package itself. No WPF file touches DiscordRPC
         types directly. ProtectedData IS used here (ThemeManager credential storage). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- WindowsForms assembly for NotifyIcon (system tray) support -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="AudioAuditor.Core\AudioAuditor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>AudioAuditor.Windows.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Third-party license/notice files, embedded into the exe so the Credits window can open
       them in both the installer and the single-file portable build -->
  <ItemGroup>
    <Resource Include="Third.Party.Notices\**\*.txt" />
  </ItemGroup>

  <!-- Bundled FFmpeg (LGPL build) for audio conversion, invoked as a separate process.
       Drop the executable into third-party\ffmpeg\. The wildcard keeps the build working
       before the binary is added, and copies it next to the app (where FindFfmpeg looks). -->
  <ItemGroup>
    <None Include="third-party\ffmpeg\**\*" CopyToOutputDirectory="PreserveNewest"
          Link="third-party\ffmpeg\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Bundled cambia (MIT) CD rip-log checker, invoked as a separate process by the
       CD Rip Checker. Drop the executable into third-party\cambia\; the wildcard copies it
       next to the app (where RipLogCheckService.FindCambia looks). -->
  <ItemGroup>
    <None Include="third-party\cambia\**\*" CopyToOutputDirectory="PreserveNewest"
          Link="third-party\cambia\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
    <Resource Include="Resources\icon.png" />
    <Resource Include="Resources\Qobuz.png" />
    <Resource Include="Resources\Amazon-music.png" />
    <Resource Include="Resources\Spotify.png" />
    <Resource Include="Resources\YTM.png" />
    <Resource Include="Resources\Tidal.png" />
    <Resource Include="Resources\Apple_music.png" />
    <Resource Include="Resources\Soundcloud.png" />
    <Resource Include="Resources\Deezer.png" />
    <Resource Include="Resources\last.fm.png" />
  </ItemGroup>

</Project>
